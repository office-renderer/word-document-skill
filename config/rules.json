{
  "version": 1,
  "template_path": "assets/公文排版Word模板.dotx",
  "body": {
    "style": "正文（默认）",
    "first_line_twips": 640,
    "auto_map_from_styles": [
      "Normal"
    ],
    "auto_map_min_chars": 12
  },
  "pagination": {
    "disable": [
      "widow_control",
      "keep_with_next",
      "keep_together",
      "page_break_before"
    ]
  },
  "table": {
    "paragraph_style": "表格正文",
    "font_pt": 14,
    "max_width_twips": 8845,
    "layout": "fixed",
    "horizontal_alignment": "center",
    "vertical_alignment": "center",
    "zero_indentation": true
  },
  "fonts": {
    "split_mixed_runs": true,
    "western_default": "Times New Roman",
    "east_asia_fallback": "仿宋_GB2312"
  },
  "metadata": {
    "remove_parts": [
      "docProps/core.xml",
      "docProps/app.xml",
      "docProps/custom.xml"
    ],
    "relationship_types": [
      "http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties",
      "http://schemas.openxmlformats.org/officeDocument/2006/relationships/extended-properties",
      "http://schemas.openxmlformats.org/officeDocument/2006/relationships/custom-properties"
    ]
  },
  "validation": {
    "quick_required_parts": [
      "[Content_Types].xml",
      "_rels/.rels",
      "word/document.xml",
      "word/styles.xml",
      "word/settings.xml",
      "word/_rels/document.xml.rels"
    ]
  },
  "language": {
    "theme_font_east_asia": "zh-CN"
  }
}
